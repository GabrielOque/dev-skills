# -----------------------------------------------------------------------------
# {{PROJECT_NAME}} — backend environment
#
# Copy to `.env` for local development (`.env` is git-ignored). Deployed
# environments set these same variables in the hosting platform. Every
# variable read in config/settings.py is listed here; add new ones in the
# same change that reads them.
# -----------------------------------------------------------------------------

# local | test | production. Switches infrastructure only (HTTPS cookies,
# static files storage); never business behaviour.
ENV=local
DEBUG=True
# Required outside `local`. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Optional: a separate key for signing JWTs (defaults to SECRET_KEY).
JWT_SIGNING_KEY=

PROJECT_NAME={{PROJECT_NAME}}
TIME_ZONE={{TIME_ZONE}}
LOG_LEVEL=INFO

# Comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Defaults to CORS_ALLOWED_ORIGINS. Add the backend's own public URL when
# deployed (Django admin login over HTTPS).
CSRF_TRUSTED_ORIGINS=
# Used to build the links in activation / password-reset emails.
FRONTEND_URL=http://localhost:3000

# --- Database -----------------------------------------------------------------
# On a platform, DATABASE_URL is usually injected and wins over DB_*.
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_SSL_REQUIRE=False
DB_CONN_MAX_AGE=60
DB_NAME={{PROJECT_DB}}
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Sessions -----------------------------------------------------------------
# The session lives as long as the refresh token; access tokens are renewed
# silently by the frontend.
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=3
# Hours an activation / password-reset link stays valid.
VALIDATION_CODE_HOURS=24
# Rate limit of the public auth endpoints (login, activation, reset), per IP.
AUTH_THROTTLE_RATE=20/minute
# Number of proxies in front of the app (1 behind a platform load balancer),
# so rate limiting sees the real client IP. Leave empty locally.
NUM_PROXIES=

# --- Email ----------------------------------------------------------------------
# Locally the console backend prints emails. Elsewhere, any SMTP provider.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# --- File storage (optional) ----------------------------------------------------
# Leave AWS_STORAGE_BUCKET_NAME empty to store uploads on the local disk.
# AWS_S3_ENDPOINT_URL is only for S3-compatible services (R2, MinIO…).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_QUERYSTRING_EXPIRE=3600
